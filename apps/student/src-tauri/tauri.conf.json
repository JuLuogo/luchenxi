{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "课堂小组端",
  "version": "4.0.0",
  "identifier": "top.peroe.luchenxi.student",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "课堂小组端",
        "width": 420,
        "height": 860,
        "resizable": true,
        "center": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "课堂小组端",
    "longDescription": "课堂积分系统学生小组端：按小组入座、答题、抢答、查看本组与个人看板。",
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": []
    }
  },
  "plugins": {}
}
